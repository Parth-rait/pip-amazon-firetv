{
  "name": "pip-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke:ai": "tsx scripts/smoke-ai.ts",
    "fake:tv": "tsx scripts/fake-tv.ts",
    "smoke:join": "tsx scripts/smoke-join.ts",
    "eval:ask": "tsx scripts/eval-ask.ts",
    "draft:quiz": "tsx scripts/draft-quiz.ts",
    "smoke:quiz": "tsx scripts/smoke-quiz.ts",
    "sim:touch": "tsx scripts/sim-touch.ts",
    "annotate": "tsx scripts/annotate.ts",
    "pipeline": "tsx scripts/pipeline.ts",
    "lab:film": "tsx scripts/make-lab-film.ts",
    "companion:images": "sh scripts/companion-images.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
