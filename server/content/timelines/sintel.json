  "lines": [
    {
      "id": "ln-01069",
      "startSec": 106.94,
      "endSec": 109.44,
      "text": "This blade has a dark past."
    },
    {
      "id": "ln-01115",
      "startSec": 111.54,
      "endSec": 114.14,
      "text": "It has shed much innocent blood."
    },
    {
      "id": "ln-01177",
      "startSec": 117.72,
      "endSec": 121.44,
      "text": "You're a fool for traveling alone, so completely unprepared."
    },
    {
      "id": "ln-01214",
      "startSec": 121.44,
      "endSec": 125.04,
      "text": "You're lucky your blood's still flowing."
    },
    {
      "id": "ln-01250",
      "startSec": 125.04,
      "endSec": 127.32,
      "text": "Thank you."
    },
    {
      "id": "ln-01273",
      "startSec": 127.32,
      "endSec": 132.96,
      "text": "So what brings you to the land of the gatekeepers?"
    },
    {
      "id": "ln-01330",
      "startSec": 132.96,
      "endSec": 137.6,
      "text": "Um, I'm searching for someone."
    },
    {
      "id": "ln-01376",
      "startSec": 137.6,
      "endSec": 143.7,
      "text": "Someone very dear, a kindred spirit, a dragon."
    },
    {
      "id": "ln-01477",
      "startSec": 147.72,
      "endSec": 150.88,
      "text": "A dangerous quest for a lone hunter."
    },
    {
      "id": "ln-01509",
      "startSec": 150.88,
      "endSec": 154.72,
      "text": "I've been alone for as long as I can remember."
    },
    {
      "id": "ln-01955",
      "startSec": 195.54,
      "endSec": 196.38,
      "text": "Shh."
    },
    {
      "id": "ln-02065",
      "startSec": 206.54,
      "endSec": 211.54,
      "text": "Shh, shh, shh. We're almost done. Hey, sit still."
    },
    {
      "id": "ln-02155",
      "startSec": 215.54,
      "endSec": 216.54,
      "text": "Hmm."
    },
    {
      "id": "ln-02275",
      "startSec": 227.54,
      "endSec": 229.54,
      "text": "Goodnight, Scales."
    },
    {
      "id": "ln-02500",
      "startSec": 249.96,
      "endSec": 250.96,
      "text": "Get him, Scales!"
    },
    {
      "id": "ln-02510",
      "startSec": 250.96,
      "endSec": 251.96,
      "text": "Come on, get him!"
    },
    {
      "id": "ln-02649",
      "startSec": 264.86,
      "endSec": 265.76,
      "text": "Scales?"
    },
    {
      "id": "ln-03063",
      "startSec": 306.34,
      "endSec": 307.18,
      "text": "Mom!"
    },
    {
      "id": "ln-03383",
      "startSec": 338.3,
      "endSec": 339.8,
      "text": "Scout!"
    },
    {
      "id": "ln-04458",
      "startSec": 445.8,
      "endSec": 447.22,
      "text": "I have failed."
    },
    {
      "id": "ln-04527",
      "startSec": 452.68,
      "endSec": 455.18,
      "text": "You've only failed your C."
    },
    {
      "id": "ln-04577",
      "startSec": 457.68,
      "endSec": 460.48,
      "text": "These are dragon lands, Sintel."
    },
    {
      "id": "ln-04605",
      "startSec": 460.48,
      "endSec": 462.9,
      "text": "You are closer than you know."
    },
    {
      "id": "ln-05574",
      "startSec": 557.42,
      "endSec": 558.42,
      "text": "Scales!"
    },
    {
      "id": "ln-05782",
      "startSec": 578.24,
      "endSec": 580.08,
      "text": "Hey!"
    },
    {
      "id": "ln-05986",
      "startSec": 598.58,
      "endSec": 599.58,
      "text": "Lemon."
    },
    {
      "id": "ln-06213",
      "startSec": 621.32,
      "endSec": 622.16,
      "text": "Scales?"
    },
    {
      "id": "ln-06258",
      "startSec": 625.76,
      "endSec": 626.6,
      "text": "Scales?"
    },
    {
      "id": "ln-07475",
      "startSec": 747.46,
      "endSec": 754.16,
      "text": "Come take my journey in tonight"
    },
    {
      "id": "ln-07542",
      "startSec": 754.16,
      "endSec": 760.84,
      "text": "Come be my shadow, walk at my side"
    },
    {
      "id": "ln-07608",
      "startSec": 760.84,
      "endSec": 767.04,
      "text": "And when you see all that I have seen"
    },
    {
      "id": "ln-07670",
      "startSec": 767.04,
      "endSec": 772.04,
      "text": "Can you tell me now from time"
    },
    {
      "id": "ln-07742",
      "startSec": 774.18,
      "endSec": 779.18,
      "text": "I have been waiting all this time"
    },
    {
      "id": "ln-07807",
      "startSec": 780.72,
      "endSec": 785.72,
      "text": "For one to wake me, one to call mine"
    },
    {
      "id": "ln-07874",
      "startSec": 787.36,
      "endSec": 792.36,
      "text": "So when you're here, all that you hold dear"
    },
    {
      "id": "ln-07936",
      "startSec": 793.56,
      "endSec": 799.56,
      "text": "Do you fear what you will find?"
    },
    {
      "id": "ln-07996",
      "startSec": 799.56,
      "endSec": 805.56,
      "text": "'Cause the dawn breaks through the night"
    },
    {
      "id": "ln-08066",
      "startSec": 806.56,
      "endSec": 815.56,
      "text": "I'm alone forever longing for the home"
    },
    {
      "id": "ln-08156",
      "startSec": 815.56,
      "endSec": 820.56,
      "text": "I've found in your eyes"
    },
    {
      "id": "ln-08236",
      "startSec": 823.56,
      "endSec": 852.56,
      "text": "I will be listening for the drum to call me over far away from my tender youth and the very truth, showing me what I've begun."
    },
    {
      "id": "ln-08526",
      "startSec": 852.56,
      "endSec": 858.56,
      "text": "As the time breaks through the night"
    },
    {
      "id": "ln-08586",
      "startSec": 858.56,
      "endSec": 864.56,
      "text": "I will fall forever long"
    },
    {
      "id": "ln-08646",
      "startSec": 864.56,
      "endSec": 867.56,
      "text": "In for the fall"
    },
    {
      "id": "ln-08676",
      "startSec": 867.56,
      "endSec": 871.56,
      "text": "I found in your eyes"
    },
    {
      "id": "ln-08716",
      "startSec": 871.56,
      "endSec": 873.56,
      "text": "Your voice"
    },
    {
      "id": "ln-08736",
      "startSec": 873.56,
      "endSec": 879.56,
      "text": "Saw me through the night"
    }
  ],
