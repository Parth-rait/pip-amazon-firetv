# Copy to server/.env (gitignored). PROJECT.md section 7.4.
PORT=8787
PUBLIC_URL=http://localhost:8787
AWS_PROFILE=pip
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
AI_ENABLED=true
# bedrock (Nova 2 Lite) or ollama (a free local model, until AWS works)
AI_PROVIDER=bedrock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Keep good answers in server/data/answer-memory.json (gitignored) for instant repeats and offline answers
ANSWER_MEMORY=true
# Write the event journal to server/data/events/ (gitignored); ids are pseudonymous, no names or question text
JOURNAL=true
LOG_TEXT=false
