# Copy to server/.env (gitignored). PROJECT.md section 7.4.
PORT=8787
PUBLIC_URL=http://localhost:8787
AWS_PROFILE=pip
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
AI_ENABLED=true
# ollama (default: a free local model, nothing leaves this machine) or bedrock (Nova 2 Lite, needs AWS)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Keep good answers in server/data/answer-memory.json (gitignored) for instant repeats and offline answers
ANSWER_MEMORY=true
# Write the event journal to server/data/events/ (gitignored); ids are pseudonymous, no names or question text
JOURNAL=true
LOG_TEXT=false
# Answer from reviewed timeline facts only (accepted), or also from unreviewed drafts (candidate; development only)
TIMELINE_REVIEW=accepted
# Add the lab film (The Lantern Fox, npm run lab:film) with its reviewed timeline
LAB_CONTENT=false
# rules (default) or typesafe: a typed judgement for text the rules cannot route, which may only offer
# choices. Needs TYPESAFE_API_KEY and npm install @typesafe-ai/sdk (a paid API); unused otherwise.
INTENT_JUDGE=rules
